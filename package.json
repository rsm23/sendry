{
  "name": "sendry",
  "private": true,
  "license": "MIT",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "pnpm typecheck && vite build && tsup server/index.ts server/multichannel-worker.ts --format esm --platform node --out-dir dist-server --clean --external better-sqlite3",
    "start": "node dist-server/index.js",
    "start:worker": "node dist-server/multichannel-worker.js",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "lint": "oxlint src server tests vite.config.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "dev:services": "docker compose up -d --wait postgres redis minio clamav && docker compose up --no-deps minio-init",
    "db:seed": "tsx server/scripts/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "dev:setup": "pnpm dev:services && pnpm db:setup",
    "db:import-sqlite": "tsx server/scripts/import-sqlite.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1105.0",
    "@aws-sdk/client-sesv2": "^3.1105.0",
    "@aws-sdk/s3-request-presigner": "^3.1105.0",
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "^5.7.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "@tanstack/react-query": "^5.101.4",
    "@twilio/voice-sdk": "^2.17.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "bullmq": "^5.58.5",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "croner": "^10.0.1",
    "csv-parse": "^7.0.2",
    "csv-stringify": "^6.8.3",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.44.5",
    "express": "^5.2.1",
    "file-type": "^21.0.0",
    "firebase-admin": "^13.5.0",
    "helmet": "^8.3.0",
    "imapflow": "^1.0.195",
    "ioredis": "^5.7.0",
    "jose": "^6.2.8",
    "libphonenumber-js": "^1.12.13",
    "lucide-react": "^1.29.0",
    "mailparser": "^3.7.4",
    "multer": "^2.2.0",
    "nanoid": "^6.0.1",
    "nodemailer": "^9.0.4",
    "openai": "^7.4.0",
    "otplib": "^13.4.1",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "react-router-dom": "^7.18.2",
    "recharts": "3.8.0",
    "sanitize-html": "^2.17.6",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.7",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "twilio": "^5.9.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/mailparser": "^3.4.6",
    "@types/pg": "^8.15.5",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.4",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.9",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
